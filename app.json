{
  "expo": {
    "name": "DOTO+ Patient",
    "slug": "dotoplus",
    "scheme": "dotoplus",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3755"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bj.dotoplus.patient",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Déverrouillage biométrique de DOTO+",
        "NSCameraUsageDescription": "Scan éventuel de codes DotoCard"
      }
    },
    "android": {
      "package": "bj.dotoplus.patient",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#1E3755",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3755",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser DOTO+ à utiliser Face ID pour le déverrouillage."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser DOTO+ à utiliser la caméra."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser DOTO+ à accéder aux photos pour la pièce d'identité.",
          "cameraPermission": "Autoriser DOTO+ à prendre une photo de la pièce d'identité."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "34f41345-c34a-4ffc-a332-1334a4fd6bc8"
      }
    },
    "owner": "davidanato"
  }
}
